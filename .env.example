# =============================================================================
# X Sourcing Engine environment variables
# Copy this file to .env.local (web app) or .env (CLI). NEVER commit real values.
# =============================================================================

# The public web deployment needs NO variables. It runs in demonstration mode
# with the bundled sample dataset. The variables below only enable the optional,
# governed CLI sourcing engine, which performs real (paid) X API sourcing.

# X API bearer token, used ONLY by the server-side CLI engine.
# Never exposed to the browser. The /api/source route reports whether this is
# present, never its value.
X_BEARER_TOKEN=your_x_api_bearer_token_here

# Optional: only needed if you run the CLI's LLM summary step. The LLM step
# summarizes already-scored text; it never assigns a score.
ANTHROPIC_API_KEY=your_anthropic_key_here
