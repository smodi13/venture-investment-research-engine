# Secrets. The application needs none, but the rules stay so one can never be
# committed by accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt
secrets/
credentials/
tokens/

# Private or scraped research data
private-data/
raw-data/
scraped-data/
/data/
/research/
/private/
*.db
*.sqlite
*.sqlite3

# Node and Next.js
node_modules/
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Deployment
.vercel
.vercel/

# Test artifacts
playwright-report/
test-results/
coverage/
tests/.tmp-downloads/

# Screenshots and browser automation artifacts
*.png
*.jpg
*.jpeg
*.gif
.playwright-mcp/

# Python tooling, in case any is ever added
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Local caches and temporary files
.cache/
.temp/
tmp/
*.log

# OS and editor
.DS_Store
Thumbs.db
.vscode/
.idea/
